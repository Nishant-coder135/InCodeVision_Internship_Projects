{
    "project_metadata": {
        "name": "Customer Churn Predictor",
        "random_state": 42
    },
    "file_paths": {
        "raw_data_path": "data/raw_data/Customer Churn.csv",
        "sweetviz_html_path": "../notebooks/raw_customer_churn_profile.html"
